rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /livros/{livroId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /generos/{generoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
